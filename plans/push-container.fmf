---
summary: Build and push maistra-builder container image (post-submit)

prepare:
  - name: Install Docker CE and QEMU
    how: shell
    script: |
      dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
      dnf install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin git make
      systemctl start docker
      systemctl enable docker
      docker info
      # Register QEMU user-mode emulators for cross-architecture builds.
      # This enables buildx to cross-compile ARM images on x86 machines
      # via QEMU, matching how Prow builds multi-arch images.
      # Pinned to latest as of 2026-10-08. To update:
      #   skopeo inspect docker://docker.io/tonistiigi/binfmt:latest | jq -r .Digest
      docker run --privileged --rm tonistiigi/binfmt@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0 --install all

discover:
  how: shell
  tests:
    - name: /push-container
      test: bash push-container.sh
      path: /plans
      duration: 5h

execute:
  how: tmt

